rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}/accounts/{accountId}
// Document ID: Firestore-generated ID
// Fields:
//   - name: string (required, 1-300 characters)
//   - status: list (required, 1-10 unique allowed account statuses)
//     Legacy documents may still contain one allowed status string until their
//     status is edited, at which point the client migrates it to a list.
//   - note: string (optional, 0-1000 characters)
//   - trackingCode: string (optional, 0-100 characters)
//   - imageSlots: list (optional, unique subset of slot1 and slot2)
//   - images: empty list (optional legacy field retained for compatibility)
//   - createdAt: timestamp (required, immutable)
//   - updatedAt: timestamp (required, server-managed)
//
// Subcollection: users/{userId}/accounts/{accountId}/images/{slot1|slot2}
// Fields:
//   - dataUrl: string (required, Base64 image data URL, at most 680000 chars)
//   - fileName: string (required, 1-255 characters)
//   - contentType: string (required, JPEG, PNG or WEBP)
//   - size: integer (required, 1-510000 compressed bytes)
//   - createdAt: timestamp (required, immutable, server-managed)
//
// Collection: users/{userId}/credentials/{credentialId}
// Document ID: Firestore-generated ID
// Fields:
//   - siteName: string (required, 1-100 characters)
//   - url: string (required, 1-2048 characters, HTTP/HTTPS only)
//   - username: string (required, 1-320 characters)
//   - password: string (required, 1-500 characters)
//   - createdAt: timestamp (required, immutable)
//   - updatedAt: timestamp (required, server-managed)
//
// Collection: users/{userId}/preferences/discountCodes
// Document ID: fixed value discountCodes
// Fields:
//   - voucherPlatform: string (required, shopee or lazada)
//   - updatedAt: timestamp (required, server-managed)
//
// Collection: discountCodes/{discountCodeId}
// Document ID: Firestore-generated ID
// Fields:
//   - code: string (required, 1-100 characters)
//   - type: string (required, one of the three allowed discount code types)
//   - createdAt: timestamp (required, immutable, server-managed)
//
// Collection: products/{platform_shopId_itemId}
// Document ID: Lazada uses lazada_shopId_itemId; legacy/Shopee uses shopId_itemId
// Fields:
//   - platform: string (optional for legacy documents, shopee or lazada)
//   - itemId: integer (required, 1-999999999999)
//   - shopId: integer (required, 1-999999999999)
//   - productName: string (required, 1-500 characters)
//   - shopName: string (required, 1-200 characters)
//   - productLink: string (required, 1-2048 characters, matching marketplace HTTPS URL)
//   - imageUrl: string (required, 0-2048 characters, empty or HTTPS URL)
//   - category: string (required, 0-300 characters)
//   - price/minPrice/maxPrice/commission: number or null
//   - sales: integer or null
//   - rating: number or null
//   - totalRatePercent: number or null
//   - isXtra: boolean (required)
//   - sourceUpdatedAt: string (required, 0-50 characters)
//   - note: string (optional, 0-1000 characters)
//   - createdAt: timestamp (required, immutable, server-managed)
//   - updatedAt: timestamp (required, server-managed)
//
// Collection: todo/{chatId_messageId}
// Documents are created only by the trusted Telegram automation through the
// Firebase Admin SDK. All visitors may read them, while every client
// create/update/delete operation is denied. Relevant fields include:
//   - text: string
//   - messageDate/expiresAt/createdAt: timestamp
//   - containsNewUserKeyword: boolean
//   - detectedCodes/links: list
//   - sourceLink/messageDay/chatTitle: string
//
// Collection: privateConfig/{configId}
// Documents contain private integration configuration. Only the fixed
// administrator may read them; all client writes are denied.
// Fields for privateConfig/addlivetag:
//   - apiKey: string (required, sensitive)
//
// Accounts, credentials and preferences belong to the authenticated user
// identified by userId. Credential documents contain private plaintext data
// and are never readable by other users. Discount codes and products contain
// no private user data and are intentionally public to read; only the fixed
// administrator can write them.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // =============================================================
    // Helper Functions
    // =============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'tungtv@account.com';
    }

    // Account documents intentionally contain no UID field; ownership comes
    // exclusively from the user-scoped document path.
    function uidUnchanged() {
      return !('uid' in request.resource.data);
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) && !('uid' in resource.data);
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidOptionalString(data, field, maxLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLength);
    }

    // =============================================================
    // Domain Validator
    // =============================================================

    function isAllowedAccountStatus(status) {
      return status in [
        'Tài khoản mới',
        'Tài khoản shopee mới',
        'Đang đặt đơn',
        'Đã sử dụng shopee',
        'Đang sử dụng Lazada',
        'Đã sử dụng Lazada',
        'Đã khóa mã người mới',
        'Đã khóa M02',
        'Đã khóa M04',
        'Đã khóa F02'
      ];
    }

    function isValidAccountStatus(status) {
      return (status is string && isAllowedAccountStatus(status))
        || (status is list
          && status.size() >= 1
          && status.size() <= 10
          && status.toSet().size() == status.size()
          && status.hasOnly([
            'Tài khoản mới',
            'Tài khoản shopee mới',
            'Đang đặt đơn',
            'Đã sử dụng shopee',
            'Đang sử dụng Lazada',
            'Đã sử dụng Lazada',
            'Đã khóa mã người mới',
            'Đã khóa M02',
            'Đã khóa M04',
            'Đã khóa F02'
          ]));
    }

    function isValidLegacyAccountImages(data) {
      return !('images' in data)
        || (data.images is list && data.images.size() == 0);
    }

    function isValidAccountImageSlots(data) {
      return !('imageSlots' in data)
        || (data.imageSlots is list
          && data.imageSlots.size() <= 2
          && data.imageSlots.toSet().size() == data.imageSlots.size()
          && data.imageSlots.hasOnly(['slot1', 'slot2']));
    }

    function isValidAccount(data) {
      return hasRequiredFields(data, ['name', 'status', 'createdAt', 'updatedAt'])
        && hasOnlyAllowedFields(data, [
          'name',
          'status',
          'note',
          'trackingCode',
          'imageSlots',
          'images',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 300
        && isValidAccountStatus(data.status)
        && isValidOptionalString(data, 'note', 1000)
        && isValidOptionalString(data, 'trackingCode', 100)
        && isValidAccountImageSlots(data)
        && isValidLegacyAccountImages(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccountImageData(data) {
      return hasRequiredFields(data, [
          'dataUrl',
          'fileName',
          'contentType',
          'size',
          'createdAt'
        ])
        && hasOnlyAllowedFields(data, [
          'dataUrl',
          'fileName',
          'contentType',
          'size',
          'createdAt'
        ])
        && data.dataUrl is string
        && data.dataUrl.size() >= 1
        && data.dataUrl.size() <= 680000
        && ((data.contentType == 'image/jpeg'
            && data.dataUrl.matches('^data:image/jpeg;base64,.*'))
          || (data.contentType == 'image/png'
            && data.dataUrl.matches('^data:image/png;base64,.*'))
          || (data.contentType == 'image/webp'
            && data.dataUrl.matches('^data:image/webp;base64,.*')))
        && data.fileName is string
        && data.fileName.size() >= 1
        && data.fileName.size() <= 255
        && data.size is int
        && data.size >= 1
        && data.size <= 510000
        && data.createdAt is timestamp;
    }

    function isValidCredential(data) {
      return hasRequiredFields(data, ['siteName', 'url', 'username', 'password', 'createdAt', 'updatedAt'])
        && hasOnlyAllowedFields(data, ['siteName', 'url', 'username', 'password', 'createdAt', 'updatedAt'])
        && data.siteName is string
        && data.siteName.size() >= 1
        && data.siteName.size() <= 100
        && data.url is string
        && data.url.size() >= 1
        && data.url.size() <= 2048
        && (data.url.matches('^https://.*') || data.url.matches('^http://.*'))
        && data.username is string
        && data.username.size() >= 1
        && data.username.size() <= 320
        && data.password is string
        && data.password.size() >= 1
        && data.password.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDiscountCodePreference(data) {
      return hasRequiredFields(data, ['voucherPlatform', 'updatedAt'])
        && hasOnlyAllowedFields(data, ['voucherPlatform', 'updatedAt'])
        && data.voucherPlatform is string
        && data.voucherPlatform in ['shopee', 'lazada']
        && data.updatedAt is timestamp;
    }

    function isValidDiscountCode(data) {
      return hasRequiredFields(data, ['code', 'type', 'createdAt'])
        && hasOnlyAllowedFields(data, ['code', 'type', 'createdAt'])
        && data.code is string
        && data.code.size() >= 1
        && data.code.size() <= 100
        && data.type is string
        && data.type in [
          'Siêu hội học đường',
          'Thợ săn cực phẩm',
          'Người mới'
        ]
        && data.createdAt is timestamp;
    }

    function isShopeeProduct(data) {
      return !('platform' in data) || data.platform == 'shopee';
    }

    function isLazadaProduct(data) {
      return 'platform' in data && data.platform == 'lazada';
    }

    function isValidProductNumber(value, minValue, maxValue) {
      return value == null
        || (value is number && value >= minValue && value <= maxValue);
    }

    function isValidProductLink(data) {
      return (isShopeeProduct(data)
          && (data.productLink.matches('^https://([a-z0-9-]+\\.)*shopee\\.vn/.*')
            || data.productLink.matches('^https://([a-z0-9-]+\\.)*shp\\.ee/.*')))
        || (isLazadaProduct(data)
          && (data.productLink.matches('^https://([a-z0-9-]+\\.)*lazada\\.vn/.*')
            || data.productLink.matches('^https://([a-z0-9-]+\\.)*lzd\\.co/.*')));
    }

    function isValidProduct(data) {
      return hasRequiredFields(data, [
          'itemId',
          'shopId',
          'productName',
          'shopName',
          'productLink',
          'imageUrl',
          'category',
          'price',
          'minPrice',
          'maxPrice',
          'sales',
          'rating',
          'commission',
          'totalRatePercent',
          'isXtra',
          'sourceUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && hasOnlyAllowedFields(data, [
          'platform',
          'itemId',
          'shopId',
          'productName',
          'shopName',
          'productLink',
          'imageUrl',
          'category',
          'price',
          'minPrice',
          'maxPrice',
          'sales',
          'rating',
          'commission',
          'totalRatePercent',
          'isXtra',
          'sourceUpdatedAt',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && (isShopeeProduct(data) || isLazadaProduct(data))
        && data.itemId is int
        && data.itemId >= 1
        && data.itemId <= 999999999999
        && data.shopId is int
        && data.shopId >= 1
        && data.shopId <= 999999999999
        && data.productName is string
        && data.productName.size() >= 1
        && data.productName.size() <= 500
        && data.shopName is string
        && data.shopName.size() >= 1
        && data.shopName.size() <= 200
        && data.productLink is string
        && data.productLink.size() >= 1
        && data.productLink.size() <= 2048
        && isValidProductLink(data)
        && data.imageUrl is string
        && data.imageUrl.size() <= 2048
        && (data.imageUrl == '' || data.imageUrl.matches('^https://.*'))
        && data.category is string
        && data.category.size() <= 300
        && isValidProductNumber(data.price, 0, 1000000000000)
        && isValidProductNumber(data.minPrice, 0, 1000000000000)
        && isValidProductNumber(data.maxPrice, 0, 1000000000000)
        && (data.sales == null
          || (data.sales is int && data.sales >= 0 && data.sales <= 1000000000000))
        && isValidProductNumber(data.rating, 0, 5)
        && isValidProductNumber(data.commission, 0, 1000000000000)
        && isValidProductNumber(data.totalRatePercent, 0, 100)
        && data.isXtra is bool
        && data.sourceUpdatedAt is string
        && data.sourceUpdatedAt.size() <= 50
        && isValidOptionalString(data, 'note', 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/accounts/{accountId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && uidUnchanged()
        && isValidAccount(request.resource.data)
        && request.resource.data.status is list
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && uidNotModified()
        && isValidAccount(request.resource.data)
        && (request.resource.data.status is list
          || (resource.data.status is string
            && request.resource.data.status == resource.data.status))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/accounts/{accountId}/images/{imageId} {
      allow read: if isOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId)/accounts/$(accountId));

      allow create: if isOwner(userId)
        && imageId in ['slot1', 'slot2']
        && existsAfter(/databases/$(database)/documents/users/$(userId)/accounts/$(accountId))
        && isValidAccountImageData(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow delete: if isOwner(userId);

      // Image contents are immutable; delete and create a slot to replace one.
    }

    match /users/{userId}/credentials/{credentialId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && uidUnchanged()
        && isValidCredential(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);

      // Credential edits are not supported; replace the record instead.
    }

    match /users/{userId}/preferences/{preferenceId} {
      allow read: if isOwner(userId)
        && preferenceId == 'discountCodes';

      allow create, update: if isOwner(userId)
        && preferenceId == 'discountCodes'
        && isValidDiscountCodePreference(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      // Preference deletion is intentionally not exposed to the client.
    }

    match /discountCodes/{discountCodeId} {
      // Public read access is intentional: visitors can view codes without login.
      allow read: if true;

      allow create: if isAdmin()
        && isValidDiscountCode(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow delete: if isAdmin();

      // Discount code edits are not supported; replace the record instead.
    }

    match /todo/{todoId} {
      // Public read access is intentional: visitors can view Telegram codes without login.
      allow read: if true;

      // No client writes are allowed. The Admin SDK automation bypasses rules.
    }

    match /products/{productId} {
      // Public read access is intentional: visitors can view products without login.
      allow read: if true;

      allow create: if isAdmin()
        && isValidProduct(request.resource.data)
        && ((isShopeeProduct(request.resource.data)
            && productId.matches('^[0-9]+_[0-9]+$'))
          || (isLazadaProduct(request.resource.data)
            && productId.matches('^lazada_[0-9]+_[0-9]+$')))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && isValidProduct(request.resource.data)
        && ((isShopeeProduct(request.resource.data)
            && productId.matches('^[0-9]+_[0-9]+$'))
          || (isLazadaProduct(request.resource.data)
            && productId.matches('^lazada_[0-9]+_[0-9]+$')))
        && isShopeeProduct(request.resource.data) == isShopeeProduct(resource.data)
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /privateConfig/{configId} {
      allow read: if isAdmin();

      // No client writes are allowed. Configuration is managed through Admin SDK.
    }

    // All other paths are denied by default.
  }
}
