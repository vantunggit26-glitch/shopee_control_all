{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopee-telegram-sync-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["7,27,47 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    { "binding": "SYNC_STATUS", "id": "a68bf38bdd0e458980c8e74985607514" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://shopeetung.web.app,http://localhost:5173",
    "ALLOWED_EMAIL": "tungtv@account.com",
    "FIREBASE_WEB_API_KEY": "AIzaSyD53nJqEn-nfHpc4V_gQCl_4qH_mMzNomE",
    "GITHUB_OWNER": "vantunggit26-glitch",
    "GITHUB_REPOSITORY": "shopee_control_all",
    "GITHUB_WORKFLOW_ID": "telegram-hourly-sync.yml"
  },
  "secrets": {
    "required": [
      "GITHUB_TOKEN"
    ]
  }
}
